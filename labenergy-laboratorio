<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
const $=id=>document.getElementById(id),EF=0.4,KID=250;
const LD={inc:{n:'Incandescente',I:v=>v>0?v/(14.5*Math.pow(v/12,.2)):0,K:v=>11*Math.pow(v/12,1.2)},
led:{n:'Módulo LED',I:v=>v>9?.055*(v-9):0,K:(v,p)=>Math.max(0,100-3*Math.max(0,p-2))},
res:{n:'Resistencia 10 Ω',I:v=>v/10,K:()=>0},mot:{n:'Motor DC',I:v=>.035*v,E:v=>Math.max(0,.62-.01*Math.abs(v-12))},
off:{n:'Circuito abierto',I:()=>0,K:()=>0}};
const COL={inc:'#d97706',led:'#0b8a84',res:'#7a8b97',mot:'#c0392b'};
function rng32(a){return()=>{a|=0;a=a+0x6D2B79F5|0;let t=Math.imul(a^a>>>15,1|a);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
let rnd,run=false,timer=null,t=0,rec=[],hist=[],sus=[];
function meas(k,v,r){const L=LD[k],I=Math.max(0,L.I(v)*(1+(r()-.5)*.02)),P=v*I,K=L.K?L.K(v,P):0,lm=K*P,eta=P>0?(L.E?L.E(v)*100:K/KID*100):0;return{k,v,i:I*1000,p:P,r:I>0?v/I:0,K,lm,eta}}
function setSeed(){rnd=rng32(+$('seed').value||1);$('seedTag').textContent=$('seed').value}
function show(m){$('mI').textContent=m.i.toFixed(0)+' mA';$('mP').textContent=m.p.toFixed(2)+' W';$('mR').textContent=m.r.toFixed(1)+' Ω';$('mL').textContent=m.lm.toFixed(0)+' lm';$('mK').textContent=m.K.toFixed(1)+' lm/W';$('mE').textContent=m.eta.toFixed(1)+' %'}
function cur(){return meas($('load').value,+$('volt').value,rnd)}
function refresh(){$('vt').textContent=(+$('volt').value).toFixed(1)+' V';show(cur())}
function tick(){t+=.5;const m=cur();show(m);hist.push({t,...m});live.data.labels.push(t.toFixed(1));live.data.datasets[0].data.push(m.p);if(live.data.labels.length>40){live.data.labels.shift();live.data.datasets[0].data.shift()}live.update('none')}
function toggleRun(){run=!run;$('run').textContent=run?'⏹ Pausar ensayo':'▶ Iniciar ensayo';if(run)timer=setInterval(tick,500);else clearInterval(timer)}
function addRec(src,m){m=m||cur();m.src=src;rec.push(m);render()}
function sweep(){const r=rng32(+$('seed').value||1);rec=rec.filter(x=>x.src!=='barrido');['inc','led','res','mot'].forEach(k=>[6,8,10,12,14].forEach(v=>{const m=meas(k,v,r);m.src='barrido';rec.push(m)}));render();go('res')}
function clearAll(){rec=[];hist=[];t=0;live.data.labels=[];live.data.datasets[0].data=[];live.update();setSeed();render()}
function avgAt12(k,f){const a=rec.filter(x=>x.k===k&&x.v===12);return a.length?{v:a.reduce((s,x)=>s+x[f],0)/a.length,m:1}:{v:(()=>{const m=meas(k,12,()=>.5);return m[f]})(),m:0}}
function render(){$('tb').innerHTML=rec.length?rec.map(x=>`<tr><td>${LD[x.k].n}</td><td class=n>${x.v}</td><td class=n>${x.i.toFixed(0)}</td><td class=n>${x.p.toFixed(2)}</td><td class=n>${x.r.toFixed(1)}</td><td class=n>${x.lm.toFixed(0)}</td><td class=n>${x.K.toFixed(1)}</td><td class=n>${x.eta.toFixed(1)}</td></tr>`).join(''):'<tr><td colspan=8 class=dim>Sin datos. Use «Registrar punto» o «Barrido automático».</td></tr>';
 ['cIV','cEta'].forEach((id,j)=>{const c=id==='cIV'?civ:ceta;c.data.datasets=Object.keys(COL).filter(k=>j==0||k!=='res').map(k=>({label:LD[k].n,borderColor:COL[k],backgroundColor:COL[k],tension:.2,data:rec.filter(x=>x.k===k).sort((a,b)=>a.v-b.v).map(x=>({x:x.v,y:j?x.eta:x.i}))}));c.update()});
 const a=avgAt12('inc','K'),b=avgAt12('led','K'),z=avgAt12('res','eta'),ratio=b.v/a.v;
 $('h1').innerHTML=`K incandescente = <b>${a.v.toFixed(1)}</b> lm/W · K LED = <b>${b.v.toFixed(1)}</b> lm/W · razón = <b class="m">${ratio.toFixed(1)}×</b> · η resistencia = ${z.v.toFixed(1)} %<br>H1 <b class="${ratio>=5&&z.v===0?'ok':'bad'}">${ratio>=5&&z.v===0?'se cumple':'no se cumple'}</b> con ${a.m&&b.m?'datos registrados a 12 V':'valores del modelo (registre puntos a 12 V para usar sus datos)'}.`;proj()}
function proj(){const lm=+$('lm').value,h=+$('hrs').value,n=+$('nl').value,tf=+$('tar').value,pi=+$('pi').value,pl=+$('pl').value,vi=+$('vi').value,vl=+$('vl').value;
 const ka=avgAt12('inc','K'),kb=avgAt12('led','K'),P=[lm/ka.v,lm/kb.v],pr=[pi,pl],vd=[vi,vl],H=15000;
 const kwh=P.map(p=>p/1000*h*30*n),clp=kwh.map(k=>k*tf),co=kwh.map(k=>k*EF),tot=P.map((p,i)=>n*(Math.ceil(H/vd[i])*pr[i]+p/1000*H*tf));
 const row=(l,f,u)=>{const x=f(0),y=f(1);return`<tr><td>${l}</td><td class=n>${x.toLocaleString('es-CL',{maximumFractionDigits:1})}${u}</td><td class=n>${y.toLocaleString('es-CL',{maximumFractionDigits:1})}${u}</td><td class="n ok">−${(x-y).toLocaleString('es-CL',{maximumFractionDigits:1})}${u}</td></tr>`};
 $('pt').innerHTML=row('Potencia por lámpara',i=>P[i],' W')+row('Energía / mes',i=>kwh[i],' kWh')+row('Costo energía / mes',i=>Math.round(clp[i]),' CLP')+row('CO₂ / mes',i=>co[i],' kg')+row('Costo total en 15.000 h',i=>Math.round(tot[i]),' CLP');
 $('src').textContent='Potencias calculadas como P = lm / K con K a 12 V ('+(ka.m&&kb.m?'datos registrados':'modelo')+'). Extrapolación a 220 V: proyección, no medición.'}
